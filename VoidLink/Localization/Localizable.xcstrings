    "layoutToolTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the world of touch control game streaming!\n\n- The “Default” layout can’t be modified, please tap the “tray / drawer” icon to duplicate it and edit the copy instead.\n\n-  Please carefully read the one-time pop-up tips that appear during use. They will help you understand how to use this layout tool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎来到触屏串流的世界！\n\n- “Default” 即默认布局无法被修改保存，请点击 [抽屉] 图标，将其复制并修改其副本。\n\n- 请仔细阅读使用过程中弹出的其他一次性提示， 这将帮助您理解如何使用布局修改工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歡迎來到觸控串流的世界！\n\n- 「Default」即預設佈局，無法被修改儲存。請點選「抽屜」圖示，將其複製後再修改副本。\n\n- 請仔細閱讀使用過程中彈出的其他一次性提示，這將幫助您理解如何使用佈局修改工具。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歡迎來到觸控串流的世界！\n\n- 「Default」即預設佈局，無法被修改儲存。請點選「抽屜」圖示，將其複製後再修改副本。\n\n- 請仔細閱讀使用過程中彈出的其他一次性提示，這將幫助您理解如何使用佈局修改工具。"
          }
        }
      }
    },
