    "streamDimensionScaleStackTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can use this setting to reduce the difference between the streaming resolution and the intermediate-frame resolution, minimizing interpolation-induced flickering for a more natural viewing experience."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以通过该设置减小串流分辨率与中间帧分辨率的差距，从而减少插帧造成的闪烁效应，从而获得更自然的观感。\n"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以透過此設定縮小串流解析度與中間影格解析度之間的差距，減少影格插補造成的閃爍，使畫面看起來更加自然。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以透過此設定縮小串流解析度與中間影格解析度之間的差距，減少影格插補造成的閃爍，使畫面看起來更加自然。"
          }
        }
      }
    },
    "Streaming Radial Menu Delay" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
