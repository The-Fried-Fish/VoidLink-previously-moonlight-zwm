    "velocityBasedTouchpadTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a velocity based, transparent right stick touchpad (RsvPad) for 3D game camera control. Please increase the in-game right stick sensitivity first, then adjust the RsvPad sensitivity itself.\n\nCheck out the tutorial to learn how to set up the best control experience."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一个用于3D 游戏视角控制、透明的速度矢量型右摇杆触控板(RsvPad)。请先将游戏内的右摇杆灵敏度调大，再调整RsvPad自身灵敏度。\n\n查看教程了解如何设置最佳操作手感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一個用於 3D 遊戲視角控制、透明的速度向量型右搖桿觸控板（RsvPad）。請先將遊戲內的右搖桿靈敏度調高，再調整 RsvPad 自身的靈敏度。\n\n查看教學了解如何設定最佳操作手感。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一個用於 3D 遊戲視角控制、透明的速度向量型右搖桿觸控板（RsvPad）。請先將遊戲內的右搖桿靈敏度調高，再調整 RsvPad 自身的靈敏度。\n\n查看教學了解如何設定最佳操作手感。"
          }
        }
      }
    },
