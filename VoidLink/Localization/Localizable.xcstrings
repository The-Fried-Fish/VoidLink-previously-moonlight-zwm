    "First Launch Tips" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次串流提示"
          }
        },
        "zh-Hant" : {
