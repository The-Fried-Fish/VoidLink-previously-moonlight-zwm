    "NetTestFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current network connection seems to be blocking remote session. Streaming may not work while connected to this network.\n\nThe following network ports were blocked:\n%s"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备的网络连接似乎正在阻塞远程会话. 可能无法在此网络中串流.\n\n以下网络端口被阻塞:\n%s"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您目前的網路連線似乎正在阻擋遠端工作階段。在此網路上連線時，串流可能無法運作。\n\n下列網路連接埠被封鎖：\n%s"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
