    "micPermissionTip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Please grant microphone permission in your system settings, then re-enable “Redirect Mic.”\n\n- Mic redirection is only supported with Sunshine-Foundation (a Sunshine fork).\n\n- The mic audio will be encrypted during streaming"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 请前往系统设置授予 App 麦克风权限，再回到此菜单启用麦克风重定向。\n\n- 仅 Sunshine 基地版 支持麦克风重定风。\n\n- 麦克风音频在串流时将被加密传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 請前往系統設定授予 App 麥克風權限，再回到此選單啟用麥克風轉送。\n\n- 麥克風轉送僅支援 Sunshine 基地版。\n\n- 麥克風音訊在串流時將被加密傳輸。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- 請前往系統設定授予 App 麥克風權限，再回到此選單啟用麥克風轉送。\n\n- 麥克風轉送僅支援 Sunshine 基地版。\n\n- 麥克風音訊在串流時將被加密傳輸。"
          }
        }
